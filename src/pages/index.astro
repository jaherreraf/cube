---
import Layout from '../layouts/Layout.astro';
import Cube from '../components/Cube.jsx';
---
<Layout title="Rubik Core Lab">
  <div
    id="app"
    class="w-screen h-screen bg-[#0F1115] text-[#E2E8F0] font-sans overflow-hidden font-sans
           flex flex-col md:flex-row"
  >

    <!-- ─── LEFT PANEL ─── -->
    <main
      class="w-full md:w-[38vw] lg:w-[36vw]
             flex flex-col justify-between
             px-6 py-6
             sm:px-10 sm:py-10
             md:px-12 md:py-14
             lg:px-16 lg:py-16
             z-10 select-none flex-shrink-0"
    >
      <header class="font-mono text-[10px] sm:text-xs tracking-widest text-white/40">
        Jaherrera-F
      </header>

      <div class="my-auto space-y-4 sm:space-y-6 pt-6 md:pt-0">
        <h1 class="text-3xl sm:text-4xl md:text-4xl lg:text-5xl font-extrabold tracking-tight uppercase leading-none font-display">
          INTERACTS WITH<br />
          <span class="text-white/60 font-mono text-2xl sm:text-3xl md:text-3xl lg:text-4xl lowercase">
            &lt;/rubik.solve&gt;
          </span>
        </h1>

        <p class="text-xs sm:text-sm text-white/50 max-w-xs sm:max-w-sm leading-relaxed">
          Experience smooth 3D simulation driven by advanced solver algorithms
          and responsive web state management.
        </p>
      </div>

      <footer class="font-mono text-[10px] sm:text-[11px] text-white/30 flex items-center gap-2">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white/50 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-white/60"></span>
        </span>
        &gt; SYSTEM STATUS: IDLE // READY
      </footer>
    </main>

    <!-- ─── CUBE SECTION ─── -->
    <section
      class="flex-1 relative flex items-center justify-center
             bg-gradient-to-b from-[#0F1115] to-[#08090C]
             min-h-0"
    >
      <!-- subtle grid texture -->
      <div
        class="absolute inset-0 pointer-events-none"
        style="
          background-image:
            linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
          background-size: 48px 48px;
        "
      ></div>

      <!-- cube wrapper — responsive height -->
      <div
        class="relative z-10 w-full
               h-[46vw]
               sm:h-[50vw]
               md:h-[56vh]
               lg:h-[64vh]
               max-h-[520px]
               max-w-2xl
               flex items-center justify-center"
      >
        <Cube client:only="react" />
      </div>

      <!-- bottom glow -->
      <div
        class="absolute bottom-0 left-1/2 -translate-x-1/2
               w-72 sm:w-96 h-24 sm:h-32
               bg-white/[0.025] blur-3xl rounded-full pointer-events-none"
      ></div>
    </section>

    <!-- ─── RIGHT ASIDE ─── -->
    <aside
      class="
        w-full md:w-[52px] lg:w-[56px]
        h-auto md:h-full
        bg-[#E2E8F0] text-[#0F1115]
        flex md:flex-col
        justify-between items-center
        py-3 px-5
        sm:py-4 sm:px-6
        md:py-8 md:px-0
        z-20
        border-t md:border-t-0 md:border-l border-white/10
        flex-shrink-0
      "
    >
      
        <a href="https://github.com/jaherreraf"
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono text-[10px] sm:text-xs font-bold tracking-wider hover:opacity-60 transition-opacity"
      >
        &lt;/&gt; GITHUB
      </a>

      <nav
        class="flex md:flex-col gap-5 sm:gap-6 md:gap-10 lg:gap-12
               font-sans text-[10px] sm:text-xs font-black tracking-widest
               md:[writing-mode:vertical-rl] md:rotate-180
               whitespace-nowrap"
      >
        <a href="#" class="hover:opacity-60 transition-opacity">ABOUT</a>
        <a href="#" class="hover:opacity-60 transition-opacity">ALGORITHM</a>
        <a href="#" class="hover:opacity-60 transition-opacity">PORTFOLIO</a>
      </nav>

      <!-- spacer md+ -->
      <div class="hidden md:block w-4 h-4" aria-hidden="true"></div>
    </aside>
  </div>

  <script>
    const btn = document.getElementById('solve');
    btn?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('trigger-cube-solve'));
    });
  </script>
</Layout>