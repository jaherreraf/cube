---
import Layout from '../layouts/Layout.astro';
import Cube from '../components/Cube.jsx';
---

<Layout title="Rubik Core Lab">
  <div id="app" class="w-screen h-screen bg-[#0F1115] text-[#E2E8F0] font-sans overflow-hidden flex flex-col md:flex-row">
    
    <main class="w-full md:w-[40vw] h-full flex flex-col justify-between p-12 md:p-16 z-10 select-none">
      <header class="font-mono text-xs tracking-widest text-white/40">
        Jaherrera-F
      </header>

      <div class="my-auto space-y-6">
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight uppercase leading-none">
          SOLVE WITH <br />
          <span class="text-white/60 font-mono text-3xl md:text-4xl lowercase">&lt;/rubik.core&gt;</span>
        </h1>
        
        <p class="text-sm text-white/50 max-w-sm leading-relaxed">
          Un entorno interactivo 3D que combina optimización de algoritmos en tiempo real y React Three Fiber.
        </p>

        <div class="flex items-center gap-4 pt-2">
          <button class="px-6 py-2.5 bg-[#1E293B] hover:bg-[#2A3A52] text-xs font-mono tracking-wider uppercase rounded transition-colors duration-300">
            scramble
          </button>
          <button class="px-6 py-2.5 border border-white/20 hover:bg-white/5 text-xs font-mono tracking-wider uppercase rounded transition-colors duration-300">
            solve
          </button>
        </div>
      </div>

      <footer class="font-mono text-[11px] text-white/30">
        &gt; SYSTEM STATUS: IDLE // READY
      </footer>
    </main>

    <section class="flex-1 h-full relative flex items-center justify-center bg-gradient-to-b from-[#0F1115] to-[#08090C]">
      <div class="w-full h-full max-w-2xl max-h-[70vh]">
        <Cube client:load />
      </div>

      <div class="absolute bottom-0 w-96 h-32 bg-white/[0.02] blur-3xl rounded-full pointer-events-none"></div>
    </section>

    <aside class="w-full md:w-20 h-16 md:h-full bg-[#E2E8F0] text-[#0F1115] flex md:flex-col justify-between items-center py-8 px-6 md:px-0 z-20 border-t md:border-t-0 md:border-l border-white/10">
      <a href="https://github.com" target="_blank" class="font-mono text-xs font-bold tracking-wider hover:opacity-70 transition-opacity">
        &lt;/&gt; GITHUB
      </a>

      <nav class="flex md:flex-col gap-6 md:gap-12 font-sans text-xs font-black tracking-widest my-auto md:transform md:-rotate-90 whitespace-nowrap">
        <a href="#" class="hover:opacity-60 transition-opacity">ABOUT</a>
        <a href="#" class="hover:opacity-60 transition-opacity">ALGORITHM</a>
        <a href="#" class="hover:opacity-60 transition-opacity">PORTFOLIO</a>
      </nav>

      <div class="hidden md:block w-4 h-4"></div>
    </aside>

  </div>
</Layout>